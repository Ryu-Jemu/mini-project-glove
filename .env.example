OPENAI_API_KEY=
# Phase 2용. Phase 1은 doctor가 존재·형식만 확인한다.
YOUTUBE_KBO_API_KEY=
TAVILY_API_KEY=
TAVILY_INCLUDE_DOMAINS=koreabaseball.com,sports.news.naver.com,sports.naver.com,yna.co.kr,lgtwins.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=baseball-rules-phase1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL_FALLBACK=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
# 아래는 내 컴퓨터의 도커 컨테이너 주소다. 배포할 때 이 값을 그대로 쓰면 동작하지 않는다.
# 배포에서는 외부에서 접속 가능한 데이터베이스 주소로 바꾼다.
PG_DSN=postgresql://baseball:baseball-local@127.0.0.1:55432/baseball
MINIO_ENDPOINT=127.0.0.1:59000
MINIO_ACCESS_KEY=baseball-local
MINIO_SECRET_KEY=baseball-local-secret
MINIO_BUCKET=baseball-rules
ABSTAIN_DENSE_THRESHOLD=0.30
ABSTAIN_BM25_RATIO=0.15
ABSTAIN_ON_DENSE_FAILURE=false           # 임베딩 호출 실패를 '자료에 없음'으로 치지 않는다
ABSTAIN_BM25_REFERENCE=short             # bm25_ratio 분모. short=질문 길이 기준, sentence=옛 동작
RRF_WEIGHT_DENSE=0.5
RRF_WEIGHT_BM25=0.5
CONTEXT_MIN_DOCS=3                       # 컨텍스트 하한을 면제할 상위 문서 수. tunable
ENABLE_SCOPE_GATE=on                     # 야구 외 질문을 검색·답변 이전에 차단
SCOPE_GATE_LLM=auto                      # 사전으로 판정이 안 설 때만 저가 LLM 1회. off 면 통과
ENABLE_WEB_SEARCH=auto
CONTEXT_MAX_TOKENS=3000                    # 규칙집 블록 상한(o200k). tunable
LATEST_CONTEXT_MAX_TOKENS=800              # 최신정보 블록 상한. tunable
CHAT_HISTORY_MAX_MESSAGES=8                # MessagesPlaceholder n_messages == deque maxlen. tunable
REFUSAL_TAIL_MAX_CHARS=40                  # detect_status 잔여 길이. tunable
ENABLE_KBO_DATA=on                         # KBO 순위·일정·구단 정보. off 면 규칙집만 쓴다
KBO_SEASON_YEAR=0                          # 0 이면 오늘 날짜의 연도. tunable
KBO_HTTP_TIMEOUT_SECONDS=4.0               # tunable
KBO_STANDINGS_TTL_SECONDS=600              # tunable
KBO_SCHEDULE_TTL_SECONDS=1800              # tunable
KBO_CONTEXT_MAX_TOKENS=1000                # KBO 블록 상한(o200k). tunable
KBO_SCHEDULE_MAX_GAMES=10                  # 일정 블록에 나열할 경기 수. tunable
ENABLE_ANSWER_SCHEMA=on                    # 답변 구조 강제(구조화 출력). off 면 평문 답변
ANSWER_MAX_OUTPUT_TOKENS=1600              # 너무 낮으면 JSON 이 잘려 폴백 재호출이 돈다. tunable
APP_ACCESS_PIN=                            # UI 접근 코드. 숫자 4자리. 비우면 제한 없음
