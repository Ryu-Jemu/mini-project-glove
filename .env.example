OPENAI_API_KEY=
# Phase 2용. Phase 1은 doctor가 존재·형식만 확인한다.
YOUTUBE_KBO_API_KEY=
TAVILY_API_KEY=
TAVILY_INCLUDE_DOMAINS=koreabaseball.com,sports.news.naver.com,sports.naver.com,yna.co.kr,lgtwins.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=baseball-rules-phase1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL_FALLBACK=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
PG_DSN=postgresql://baseball:baseball-local@127.0.0.1:55432/baseball
MINIO_ENDPOINT=127.0.0.1:59000
MINIO_ACCESS_KEY=baseball-local
MINIO_SECRET_KEY=baseball-local-secret
MINIO_BUCKET=baseball-rules
ABSTAIN_DENSE_THRESHOLD=0.30
ABSTAIN_BM25_RATIO=0.15
RRF_WEIGHT_DENSE=0.5
RRF_WEIGHT_BM25=0.5
ENABLE_WEB_SEARCH=auto
CONTEXT_MAX_TOKENS=3000                    # 규칙집 블록 상한(o200k). tunable
LATEST_CONTEXT_MAX_TOKENS=800              # 최신정보 블록 상한. tunable
CHAT_HISTORY_MAX_MESSAGES=8                # MessagesPlaceholder n_messages == deque maxlen. tunable
REFUSAL_TAIL_MAX_CHARS=40                  # detect_status 잔여 길이. tunable
