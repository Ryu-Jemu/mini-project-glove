OPENAI_API_KEY=test-key-for-unit-tests
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_HISTORY_MAX_MESSAGES=6
TAVILY_INCLUDE_DOMAINS=koreabaseball.com,sports.news.naver.com,sports.naver.com,yna.co.kr,lgtwins.com
ENABLE_ANSWER_SCHEMA=off
ANSWER_MAX_OUTPUT_TOKENS=900
ENABLE_SCOPE_GATE=off
SCOPE_GATE_LLM=off
ENABLE_MODEL_KNOWLEDGE=off
ABSTAIN_ON_DENSE_FAILURE=true
ABSTAIN_BM25_REFERENCE=sentence
CONTEXT_MIN_DOCS=5
