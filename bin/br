#!/usr/bin/env bash
# uv 래퍼.
# macOS 에서 uv 가 .venv 의 .pth 에 UF_HIDDEN 을 설정하면 CPython site.addpackage 가
# "Skipping hidden .pth file" 로 건너뛰어 editable 패키지(baseball)가 import 되지 않는다.
# 플래그를 해제하고, 그래도 되살아나는 경우를 대비해 PYTHONPATH 로 src 를 고정한다.
# --no-sync 는 매 실행 재빌드를 막는다(의존성 변경 후에는 `make sync`).
set -euo pipefail
cd "$(dirname "$0")/.."
chflags nohidden .venv/lib/python3.12/site-packages/*.pth 2>/dev/null || true
export PYTHONPATH="$PWD/src${PYTHONPATH:+:$PYTHONPATH}"
exec uv run --no-sync "$@"
